@page "/thread"
@inject Thymus.Web.Services.BffApiClient ApiClient

<PageTitle>@(_title ?? "Tråd")</PageTitle>

@if (_loading)
{
    <p>Laddar...</p>
}
else if (_unauthorized)
{
    <p>Du är inte inloggad. <a href="/login">Logga in</a></p>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
    <p><a href="javascript:history.back()">Tillbaka</a></p>
}
else
{
    <h1>@_title</h1>
    <p><a href="javascript:history.back()">Tillbaka</a></p>

    @if (_posts.Count == 0)
    {
        <p>Inga inlägg hittades.</p>
    }
    else
    {
        @foreach (Contracts.PostDto post in _posts)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between">
                    <strong>@post.Author</strong>
                    <small class="text-muted">@post.PostedAt</small>
                </div>
                <div class="card-body">
                    <p class="card-text" style="white-space: pre-wrap;">@post.Body</p>
                </div>
            </div>
        }
    }

    @if (_nextStart is not null)
    {
        <button class="btn btn-outline-primary" @onclick="LoadMoreAsync" disabled="@_loadingMore">
            @(_loadingMore ? "Laddar..." : "Ladda fler inlägg")
        </button>
    }

    <div class="mt-4">
        <h5>Svara i tråden</h5>
        @if (_replyError is not null)
        {
            <div class="alert alert-danger">@_replyError</div>
        }
        @if (_replySent)
        {
            <div class="alert alert-success">Inlägget skickades!</div>
        }
        <textarea class="form-control mb-2" rows="5" placeholder="Skriv ditt svar här..."
            @bind="_replyMessage" @bind:event="oninput" disabled="@_sendingReply"></textarea>
        <button class="btn btn-primary" @onclick="SendReplyAsync" disabled="@(_sendingReply || string.IsNullOrWhiteSpace(_replyMessage))">
            @(_sendingReply ? "Skickar..." : "Skicka svar")
        </button>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "url")]
    public string? TopicUrl { get; set; }

    private readonly List<PostDto> _posts = new();
    private string? _title;
    private bool _loading = true;
    private bool _unauthorized;
    private bool _loadingMore;
    private int? _nextStart;
    private bool _newestFirst = true;
    private string _replyMessage = string.Empty;
    private bool _sendingReply;
    private bool _replySent;
    private string? _replyError;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync(0, reset: true);
    }

    private async Task LoadPageAsync(int start, bool reset)
    {
        if (reset)
            _loading = true;
        else
            _loadingMore = true;

        if (string.IsNullOrWhiteSpace(TopicUrl))
        {
            _loading = false;
            return;
        }

        _error = null;
        PostsPageDto? page = null;
        try
        {
            page = await ApiClient.GetThreadPageAsync(TopicUrl, start, _newestFirst);
        }
        catch (TaskCanceledException)
        {
            _error = "Forumet svarade inte i tid, försök igen.";
            _loading = false;
            _loadingMore = false;
            return;
        }
        catch (HttpRequestException)
        {
            _error = "Kunde inte nå servern, försök igen.";
            _loading = false;
            _loadingMore = false;
            return;
        }

        if (page is null)
        {
            _unauthorized = true;
        }
        else
        {
            if (reset)
            {
                _posts.Clear();
                _title = page.Title;
            }

            var existingPostKeys = _posts
                .Select(BuildPostKey)
                .ToHashSet(StringComparer.Ordinal);

            var incomingPosts = new List<PostDto>();

            foreach (var post in page.Posts)
            {
                if (existingPostKeys.Add(BuildPostKey(post)))
                    incomingPosts.Add(post);
            }

            if (_newestFirst)
                _posts.InsertRange(0, incomingPosts);
            else
                _posts.AddRange(incomingPosts);

            _nextStart = page.NextStart;
        }

        _loading = false;
        _loadingMore = false;
    }

    private async Task LoadMoreAsync()
    {
        if (_nextStart is null)
            return;

        await LoadPageAsync(_nextStart.Value, reset: false);
    }

    private async Task SendReplyAsync()
    {
        if (string.IsNullOrWhiteSpace(_replyMessage) || string.IsNullOrWhiteSpace(TopicUrl))
            return;

        _sendingReply = true;
        _replyError = null;
        _replySent = false;

        var subject = string.IsNullOrWhiteSpace(_title) ? string.Empty : $"Re: {_title}";
        
        try
        {
            var success = await ApiClient.PostReplyAsync(TopicUrl, subject, _replyMessage);

            if (success)
            {
                _replyMessage = string.Empty;
                _replySent = true;
                await LoadPageAsync(0, reset: true);
            }
            else
            {
                _replyError = "Det gick inte att skicka inlägget. Försök igen.";
            }
        }
        catch (TaskCanceledException)
        {
            _replyError = "Forumet svarade inte i tid, försök igen.";
        }
        catch (HttpRequestException)
        {
            _replyError = "Kunde inte nå servern, försök igen.";
        }

        _sendingReply = false;
    }

    private static string BuildPostKey(PostDto post)
    {
        if (post.MessageId > 0)
            return $"id:{post.MessageId}";

        var postedAtTicks = post.PostedAt?.UtcTicks ?? 0;
        var normalizedBody = string.Join(
            " ",
            (post.Body ?? string.Empty).Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));

        return $"fallback:{post.Author}|{postedAtTicks}|{normalizedBody}";
    }
}
