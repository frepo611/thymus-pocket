@inherits LayoutComponentBase
@inject Thymus.Web.Services.BffApiClient ApiClient
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <EditForm FormName="layout-logout" Model="_logoutModel" OnSubmit="HandleLogoutAsync" method="post" class="ms-auto">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Logga ut</button>
            </EditForm>
        </div>

        <article class="content px-4">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger mt-3" role="alert">@_error</div>
            }

            @Body
        </article>
    </main>
</div>

@code {
    private readonly object _logoutModel = new();
    private string? _error;

    private async Task HandleLogoutAsync(EditContext _)
    {
        _error = null;

        var ok = await ApiClient.LogoutAsync();
        if (!ok)
        {
            _error = "Utloggningen misslyckades.";
            return;
        }

        Navigation.NavigateTo("/login");
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
