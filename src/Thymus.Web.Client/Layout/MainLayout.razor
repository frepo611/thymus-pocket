@inherits LayoutComponentBase
@inject Thymus.Web.Client.Services.BffApiClient ApiClient
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="HandleLogoutAsync">
    Logga ut
</button>
        </div>

        <article class="content px-4">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger mt-3" role="alert">@_error</div>
            }

            @Body
        </article>
    </main>
</div>

@code {
    private string? _error;

    private async Task HandleLogoutAsync()
    {
        _error = null;

        var ok = await ApiClient.LogoutAsync();
        if (!ok)
        {
            _error = "Utloggningen misslyckades.";
            return;
        }

        Navigation.NavigateTo("/login");
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
