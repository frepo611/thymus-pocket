@page "/boards"
@inject Thymus.Web.Client.Services.BffApiClient ApiClient

<PageTitle>Boards</PageTitle>

<h1>Boards</h1>

@if (_loading)
{
    <p>Laddar...</p>
}
else if (_unauthorized)
{
    <p>Du är inte inloggad. <a href="/login">Logga in</a></p>
}
else if (_categories is not null)
{
    foreach (var category in _categories)
    {
        <div class="mb-4">
            <h2 class="h5 border-bottom pb-1">@category.Key</h2>
            <ul class="list-group list-group-flush">
                @foreach (var board in category)
                {
                    <li class="list-group-item">
                        <a href="@($"/topics/{board.Id}")">@board.Name</a>
                    </li>
                }
            </ul>
        </div>
    }
}

@code {
    private bool _loading = true;
    private bool _unauthorized;
    private IEnumerable<IGrouping<string, BoardDto>>? _categories;

    protected override async Task OnInitializedAsync()
    {
        var boards = await ApiClient.GetBoardsAsync();

        if (boards is null)
            _unauthorized = true;
        else
            _categories = boards
                .GroupBy(
                    b => string.IsNullOrWhiteSpace(b.Category) ? "Okategoriserat" : b.Category,
                    StringComparer.Ordinal);

        _loading = false;
    }
}
